rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    match /users/{uid}/travelVault/{fileId} {
      allow read:   if request.auth != null && request.auth.uid == uid;

      // create/overwrite: owner only, ≤10 MB, PDF/JPG/PNG or encrypted blob
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024 + 64
        && request.resource.contentType in ['application/pdf','image/jpeg','image/png','application/octet-stream'];

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // everything else is closed
    match /{allPaths=**} { allow read, write: if false; }
  }
}
